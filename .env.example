# HimClimX Backend Environment Variables
# Copy this file to .env and fill in the values

# Flask settings
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# Cloudflare R2 Public URL
R2_PUBLIC_URL=https://pub-e2d58bcf3d37484daaab4821c96b004a.r2.dev

# R2 Bucket name
R2_BUCKET_NAME=himclimx

# Redis Cache (optional - for production)
# REDIS_URL=redis://localhost:6379/0

# External services
OPENAI_CHAT_URL=https://your-climate-chat.vercel.app

# Google Maps API Key (optional - for enhanced maps)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Port (set by Railway/Render automatically)
# PORT=5000
